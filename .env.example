# Copy to .env. These values never belong in Git.
DATABASE_URL=
# Optional direct PostgreSQL connection for migrations; runtime uses DATABASE_URL.
DIRECT_DATABASE_URL=
POSTGRES_PASSWORD=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GITHUB_ID=
GITHUB_SECRET=
# Optional for local source collection; Actions supplies its own scoped token.
GH_TOKEN=
# Optional test database; its name must end in _test. Tests may delete its data.
TEST_DATABASE_URL=
