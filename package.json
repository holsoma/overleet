{
  "name": "overleet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.14 <23", "npm": ">=10" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run tests/database.integration.test.ts",
    "test:e2e": "playwright test",
    "setup": "node scripts/setup-local.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:sync": "tsx scripts/sync-questions.ts",
    "db:deploy": "npm run validate:questions && npm run db:migrate && npm run db:sync",
    "validate:questions": "tsx scripts/validate-questions.ts",
    "collect:questions": "tsx scripts/collect-questions.ts",
    "check:files": "tsx scripts/check-tracked-files.ts",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "next": "16.4.1", "react": "19.3.1", "react-dom": "19.3.1", "next-auth": "4.24.15",
    "@prisma/client": "7.10.0", "@prisma/adapter-pg": "7.10.0", "pg": "8.16.3",
    "zod": "4.6.7", "dotenv": "17.2.3", "react-markdown": "10.1.0", "remark-math": "6.0.0",
    "rehype-katex": "7.0.1", "katex": "0.19.0", "unified": "11.0.5", "remark-parse": "11.0.0",
    "unist-util-visit": "5.0.0", "fast-xml-parser": "5.11.2", "lucide-react": "0.468.0",
    "@radix-ui/react-slot": "1.2.3", "class-variance-authority": "0.7.1", "clsx": "2.1.1", "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "prisma": "7.10.0", "typescript": "5.9.3", "tsx": "4.23.15", "vitest": "4.1.11",
    "@playwright/test": "1.64.1", "eslint": "10.12.0", "typescript-eslint": "8.71.2", "eslint-plugin-react-hooks": "7.1.1", "globals": "17.13.0",
    "tailwindcss": "4.3.3", "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1", "@types/react": "19.2.2", "@types/react-dom": "19.2.2",
    "@types/pg": "8.15.6", "@types/katex": "0.16.7"
  },
  "overrides": { "katex": "$katex", "deepmerge-ts": "8.0.2", "mysql2": "3.24.6" }
}
