generator client {
  provider = "prisma-client"
  output = "../lib/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Difficulty {
  easy
  medium
  hard
}
enum Category {
  ml_theory
  statistics
  ab_testing
  llms
  python
  sql_databases
}
enum ProgressStatus {
  unseen
  completed
  review_later
}
model User {
  id String @id @default(cuid())
  githubId String @unique
  name String?
  image String?
  createdAt DateTime @default(now())
  progress UserProgress[]
  votes QuestionVote[]
}
model Question {
  id String @id
  title String
  difficulty Difficulty
  category Category
  companyTags String[]
  companyEvidence Json
  questionMarkdown String
  tldrAnswer String
  detailedAnswerMarkdown String
  keyTakeaways String[]
  sources Json
  active Boolean @default(true)
  contentHash String
  updatedAt DateTime @updatedAt
  progress UserProgress[]
  votes QuestionVote[]
  dailySelections DailyQuestion[]
}
model UserProgress {
  userId String
  questionId String
  status ProgressStatus
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  @@id([userId, questionId])
}
model QuestionVote {
  userId String
  questionId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  @@id([userId, questionId])
  @@index([questionId])
}
model DailyQuestion {
  date String @id
  questionId String
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
}
